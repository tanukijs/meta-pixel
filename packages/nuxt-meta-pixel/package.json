{
  "name": "nuxt-meta-pixel",
  "version": "2.0.2",
  "license": "MIT",
  "author": "tanukijs <tanuki.contact@gmail.com>",
  "description": "Nuxt best module to use Facebook's pixels in your application.",
  "keywords": [
    "meta",
    "pixel",
    "facebook",
    "fbq",
    "sdk",
    "nuxt"
  ],
  "homepage": "https://github.com/tanukijs/meta-pixel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanukijs/meta-pixel.git"
  },
  "bugs": {
    "url": "https://github.com/tanukijs/meta-pixel/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^3.21.6",
    "defu": "^6.1.7",
    "meta-pixel": "^1.1.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.7.0",
    "@nuxt/eslint-config": "^0.2.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^3.21.6",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.18.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "changelogen": "^0.6.2",
    "eslint": "^8.57.0",
    "nuxt": "^3.21.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
